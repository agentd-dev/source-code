    {
      "kind": "skill",
      "sigil": true,
      "form": "section",
      "line": 82,
      "attrs": {
        "when": "writing to customers",
        "name": "support-tone"
      },
      "body": {
        "type": "markdown",
        "text": "\nWarm, concise, specific. No filler phrases.\n\n### Openings\n\nAcknowledge what happened in one sentence before anything else.\n\n### Closings\n\nSay what happens next and when. NEVER: end with \"let us know if you have\nany other questions.\"\n"
      }
    },
    {
      "kind": "workflow",
      "sigil": true,
      "form": "section",
      "line": 95,
      "attrs": {
        "name": "approve-refund",
        "description": "Asks the on-call approver for refunds above the plan limit and records the\nanswer on the ticket."
      },
      "body": {
        "type": "yaml",
        "text": "steps:\n  start:  { kind: manual }\n  ask:    { kind: human, depends_on: [start], question: \"Approve this refund?\", schema: \"@ui/refund-approval\", to: \"@human/oncall\", timeout: 15m }\n  record: { kind: mcp.tool, depends_on: [ask], server: ticketing, tool: update, args: { approved: \"{{steps.ask.output.approve}}\" } }\n  done:   { kind: finish, depends_on: [record] }"
      }
    },
