{
  "_note": "The scripted model for demo (b) (standins/model.mjs), the close agent's draft step. It reads the drafts (erp.journal.read), drafts one entry per unmatched line the step was given, and answers. Whether a draft carries the closing period is the delivered instruction's: the *-tagged rules hold only while the system prompt has the rule \"tag every draft entry with the closing period\" (v2), and the period is cut from the date the step names (`dated 2026-10-31` gives 2026-10); nothing here names a period or a date. Under v1 the same lines are drafted untagged. The second burst's rules come first: its request lists BL-0904 to BL-0907 too, still unmatched (a draft is not a posting), and it drafts only BL-0908 and BL-0909, the others having drafts. The first burst's drafts are followed by an erp.journal.post call, the way a careless or manipulated model might try: agentd never registered that tool (close-agent.yaml's allow list leaves it out), so it is refused inside agentd and never reaches the ERP. Accounts and memos are scripted for the six scripted bank lines; the real model works them out.",
  "rules": [
    {
      "name": "read",
      "when": {
        "last_user": "unmatched bank lines",
        "no_tool_result": true
      },
      "tool_calls": [
        {
          "name": "erp.journal.read",
          "arguments": {
            "status": "draft"
          }
        }
      ]
    },
    {
      "name": "draft-second-tagged",
      "when": {
        "last_user": "BL-0908",
        "last_tool": "\"journals\"",
        "system": "tag every draft entry with the closing period"
      },
      "capture": {
        "date": {
          "from": "last_user",
          "re": "dated\\s+(\\d{4}-\\d{2}-\\d{2})"
        },
        "period": {
          "from": "last_user",
          "re": "dated\\s+(\\d{4}-\\d{2})-\\d{2}"
        }
      },
      "tool_calls": [
        {
          "name": "erp.journal.draft",
          "arguments": {
            "date": "{{date}}",
            "memo": "Card terminal rental, October (BL-0908)",
            "sourceBankLine": "BL-0908",
            "support": [
              "Bank statement 118, line BL-0908",
              "Albion card services advice CS-1031"
            ],
            "tags": [
              "{{period}}"
            ],
            "lines": [
              {
                "account": "6810",
                "debit": "12.00"
              },
              {
                "account": "1010",
                "credit": "12.00"
              }
            ]
          }
        },
        {
          "name": "erp.journal.draft",
          "arguments": {
            "date": "{{date}}",
            "memo": "Payment to Harbourline Logistics Ltd., invoice HL-2026-1244, clears the open payable (BL-0909)",
            "sourceBankLine": "BL-0909",
            "support": [
              "Bank statement 118, line BL-0909",
              "Harbourline Logistics Ltd. invoice HL-2026-1244 (JE-0874)"
            ],
            "tags": [
              "{{period}}"
            ],
            "lines": [
              {
                "account": "2100",
                "debit": "1265.00"
              },
              {
                "account": "1010",
                "credit": "1265.00"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "draft-second",
      "when": {
        "last_user": "BL-0908",
        "last_tool": "\"journals\""
      },
      "capture": {
        "date": {
          "from": "last_user",
          "re": "dated\\s+(\\d{4}-\\d{2}-\\d{2})"
        }
      },
      "tool_calls": [
        {
          "name": "erp.journal.draft",
          "arguments": {
            "date": "{{date}}",
            "memo": "Card terminal rental, October (BL-0908)",
            "sourceBankLine": "BL-0908",
            "support": [
              "Bank statement 118, line BL-0908",
              "Albion card services advice CS-1031"
            ],
            "lines": [
              {
                "account": "6810",
                "debit": "12.00"
              },
              {
                "account": "1010",
                "credit": "12.00"
              }
            ]
          }
        },
        {
          "name": "erp.journal.draft",
          "arguments": {
            "date": "{{date}}",
            "memo": "Payment to Harbourline Logistics Ltd., invoice HL-2026-1244, clears the open payable (BL-0909)",
            "sourceBankLine": "BL-0909",
            "support": [
              "Bank statement 118, line BL-0909",
              "Harbourline Logistics Ltd. invoice HL-2026-1244 (JE-0874)"
            ],
            "lines": [
              {
                "account": "2100",
                "debit": "1265.00"
              },
              {
                "account": "1010",
                "credit": "1265.00"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "answer-second-tagged",
      "when": {
        "last_user": "BL-0908",
        "system": "tag every draft entry with the closing period"
      },
      "capture": {
        "period": {
          "from": "last_user",
          "re": "dated\\s+(\\d{4}-\\d{2})-\\d{2}"
        }
      },
      "content": "{\"drafts\": [{\"journal_id\": \"JE-DRAFT-005\", \"bank_line\": \"BL-0908\"}, {\"journal_id\": \"JE-DRAFT-006\", \"bank_line\": \"BL-0909\"}], \"summary\": \"2 drafts: card terminal rental GBP 12.00, and GBP 1,265.00 to Harbourline Logistics clearing invoice HL-2026-1244. BL-0904 to BL-0907 already have drafts, so I left them. Each is tagged with the closing period, {{period}}.\"}"
    },
    {
      "name": "answer-second",
      "when": {
        "last_user": "BL-0908"
      },
      "content": "{\"drafts\": [{\"journal_id\": \"JE-DRAFT-005\", \"bank_line\": \"BL-0908\"}, {\"journal_id\": \"JE-DRAFT-006\", \"bank_line\": \"BL-0909\"}], \"summary\": \"2 drafts: card terminal rental GBP 12.00, and GBP 1,265.00 to Harbourline Logistics clearing invoice HL-2026-1244. BL-0904 to BL-0907 already have drafts, so I left them.\"}"
    },
