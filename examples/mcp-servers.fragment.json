{
  "mcp": {
    "servers": [
      {
        "name": "fs",
        "endpoint": "https://mcp-fs.internal/mcp",
        "headers": {
          "authorization": "Bearer {{secret:FS_TOKEN}}"
        },
        "tags": {
          "*": [
            "sensitive"
          ]
        }
      },
      {
        "name": "search",
        "endpoint": "https://mcp-search.internal/mcp",
        "tags": {
          "*": [
            "egress",
            "untrusted_input"
          ]
        }
      },
      {
        "name": "tickets",
        "endpoint": "https://mcp-tickets.internal/mcp",
        "tags": {
          "*": [
            "egress"
          ]
        }
      },
      {
        "name": "inbox",
        "endpoint": "https://mcp-inbox.internal/mcp",
        "tags": {
          "*": [
            "untrusted_input"
          ]
        }
      }
    ]
  }
}
