# agentd as a long-lived daemon under systemd: it idles until the ticket queue
# changes, wakes, triages, and goes back to idle.
# Install at /etc/systemd/system/agent-triage.service, then:
#   systemctl daemon-reload && systemctl enable --now agent-triage
[Unit]
Description=agentd ticket triage (subscribe-driven daemon)
After=network.target

[Service]
Type=simple
Environment=AGENT_INTELLIGENCE=https://gw.example/v1
# Secrets via EnvironmentFile (mode 0600), never on the command line or a config
# file (RFC 0011 §3.2). The file sets AGENT_INTELLIGENCE_TOKEN=...
EnvironmentFile=/etc/agentd/triage.env
# The trigger is a workflow START NODE, not a flag: the 1.x `--mode` /
# `--subscribe` pair was removed in 2.0 and is now refused by name. So
# /etc/agentd/triage.yaml carries `lifecycle: {run_until: drained}` — what keeps
# the process alive between wakes — and a workflow whose first step is
#   {kind: subscribe, server: tickets, uri: "tickets://queue/inbound"}
# Everything else stays on the command line; a flag still overrides the file.
ExecStart=/usr/local/bin/agentd \
  --config /etc/agentd/triage.yaml \
  --instruction.file /etc/agentd/triage.txt \
  --model my-model \
  --mcp tickets=https://mcp-tickets.internal/mcp \
  --drain-timeout 25s \
  --health-file /run/agent/health

# systemd's analogue of terminationGracePeriodSeconds — MUST exceed
# --drain-timeout (25s) or systemd SIGKILLs mid-drain.
TimeoutStopSec=30
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5
RuntimeDirectory=agent

[Install]
WantedBy=multi-user.target
