{
  "name": "@agentd/ui",
  "version": "0.1.0",
  "description": "The agentd web UI, in the format of the TUI: a browser display client over the same @agentd/client core. Statically hostable; `agentd-ui` serves it locally and opens the browser.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "agentd-ui": "bin/serve.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node bin/serve.mjs"
  },
  "dependencies": {
    "@agentd/client": "0.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
