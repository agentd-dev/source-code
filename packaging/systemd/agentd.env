# /etc/default/agentd — environment for agentd.service.
#
# agentd is instruction-driven: it needs an instruction (the unit of work) and an
# intelligence endpoint. Set those here, plus any flag tuning in AGENTD_ARGS
# (expanded on the ExecStart line). Full reference: `agentd --help` and
# docs/configuration.md.

# The intelligence endpoint + model (required). `https://` works out of the box:
# `tls` is on by default and the webpki roots are bundled, so there is no system
# CA bundle to mount. To drop TLS entirely, build with
# `--no-default-features` and point at a loopback `http://127.0.0.1:PORT`
# sidecar — loopback plaintext is the only carve-out the loader accepts.
AGENTD_INTELLIGENCE=https://gateway.internal/v1
AGENTD_MODEL=claude-sonnet-4-6

# The intelligence credential (redacted in logs). Prefer a systemd credential or
# a drop-in over a world-readable env file in production.
#AGENTD_INTELLIGENCE_TOKEN=

# The instruction (the unit of work). For a long instruction, point at a file
# with `--instruction.file` in AGENTD_ARGS instead.
#AGENTD_INSTRUCTION=Summarize new items and act on them.

AGENTD_LOG_LEVEL=info

# Flags. The trigger and the lifecycle live in the config file, not here: give
# the workflow a start node (`once` | `loop` | `schedule` |
# `subscribe` | `signal` | `event` | `a2a` | `manual`) and set
# `lifecycle.run_until` (`auto` | `idle` | `drained`) if the default is wrong,
# then point at the file with `--config /etc/agentd/agentd.yaml`. Add
# `--metrics-addr 127.0.0.1:9090` (local scrape) or `:9090` (all IPv4
# interfaces) to serve /healthz+/readyz+/metrics (needs the metrics build).
AGENTD_ARGS=--drain-timeout 25s
