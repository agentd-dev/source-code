{
  "$defs": {
    "envelope": {
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "workflow.run"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "$ref": "#/$defs/envelopes/$defs/workflow.run"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "workflow.signal"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "$ref": "#/$defs/envelopes/$defs/workflow.signal"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "subagent.send"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "$ref": "#/$defs/envelopes/$defs/subagent.send"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "subagent.kill"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "$ref": "#/$defs/envelopes/$defs/subagent.kill"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "_instance.result"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "$ref": "#/$defs/envelopes/$defs/_instance.result"
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "_instance.emit"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "$ref": "#/$defs/envelopes/$defs/_instance.emit"
          }
        }
      ],
      "properties": {
        "op": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "type": "object"
    },
    "envelopes": {
      "$defs": {
        "_instance.emit": {
          "additionalProperties": false,
          "properties": {
            "event": {
              "description": "The child's stream event: subject, correlation, data and id",
              "type": "object"
            },
            "handle": {
              "description": "The parent's handle for the child",
              "minLength": 1,
              "type": "string"
            },
            "op": {
              "const": "_instance.emit"
            },
            "stream": {
              "description": "The stream, by the name both sides declare",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "op",
            "handle",
            "stream",
            "event"
          ],
          "type": "object"
        },
        "_instance.result": {
          "additionalProperties": false,
          "properties": {
            "handle": {
              "description": "The parent's handle for the child",
              "minLength": 1,
              "type": "string"
            },
            "op": {
              "const": "_instance.result"
            },
            "output": {
              "description": "The child's run output"
            },
            "status": {
              "description": "The child's run status"
            }
          },
          "required": [
            "op",
            "handle"
          ],
          "type": "object"
        },
        "subagent.kill": {
          "additionalProperties": false,
          "properties": {
            "handle": {
              "description": "The subagent handle",
              "type": "string"
            },
            "op": {
              "const": "subagent.kill"
            },
            "reason": {
              "description": "Why; kept as the cancelled record's error",
              "type": "string"
            }
          },
          "required": [
            "op",
            "handle"
          ],
          "type": "object"
        },
        "subagent.send": {
          "additionalProperties": false,
          "properties": {
            "handle": {
              "description": "The subagent handle",
              "type": "string"
            },
            "message": {
              "description": "The message",
              "type": "string"
            },
            "op": {
              "const": "subagent.send"
            }
          },
          "required": [
            "op",
            "handle",
            "message"
          ],
          "type": "object"
        },
        "workflow.run": {
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "description": "The run's inputs",
              "type": "object"
            },
            "op": {
              "const": "workflow.run"
            },
            "workflow": {
              "description": "The workflow to start",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "op",
            "workflow"
          ],
          "type": "object"
        },
        "workflow.signal": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "description": "The signal a `wait: {on: signal}` step waits for",
              "minLength": 1,
              "type": "string"
            },
            "op": {
              "const": "workflow.signal"
            },
            "payload": {
              "description": "What the waiting step receives"
            },
            "run": {
              "description": "Deliver to this run only; without it, to every waiter the caller owns",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "op",
            "name"
          ],
          "type": "object"
        }
      }
    },
    "ops": {
      "subagent.kill": {
        "args": {
          "additionalProperties": false,
          "properties": {
            "handle": {
              "description": "The subagent handle",
              "type": "string"
            },
            "reason": {
              "description": "Why; kept as the cancelled record's error",
              "type": "string"
            }
          },
          "required": [
            "handle"
          ],
          "type": "object"
        },
        "description": "Stop a subagent",
        "reply": "task",
        "result": {
          "properties": {
            "handle": {
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            }
          },
          "required": [
            "ok"
          ],
          "type": "object"
        }
      },
      "subagent.send": {
        "args": {
          "additionalProperties": false,
          "properties": {
            "handle": {
              "description": "The subagent handle",
              "type": "string"
            },
            "message": {
              "description": "The message",
              "type": "string"
            }
          },
          "required": [
            "handle",
            "message"
          ],
          "type": "object"
        },
        "description": "Send a message to a warm subagent",
        "reply": "task",
        "result": {
          "properties": {
            "delivery": {
              "description": "async: an instance child takes the message over its socket",
              "type": "string"
            },
            "followed": {
              "description": "false: the send went, but its answer is not read back (too many children's answers are read already)",
              "type": "boolean"
            },
            "handle": {
              "type": "string"
            },
            "message_id": {
              "description": "An instance child's send: the A2A messageId it went as",
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            }
          },
          "required": [
            "ok"
          ],
          "type": "object"
        }
      },
      "workflow.run": {
        "args": {
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "description": "The run's inputs",
              "type": "object"
            },
            "workflow": {
              "description": "The workflow to start",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "workflow"
          ],
          "type": "object"
        },
        "description": "Start a workflow; the reply is the task it runs under",
        "reply": "task",
        "result": {
          "description": "the run's output, once the run finishes"
        }
      },
      "workflow.signal": {
        "args": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "description": "The signal a `wait: {on: signal}` step waits for",
              "minLength": 1,
              "type": "string"
            },
            "payload": {
              "description": "What the waiting step receives"
            },
            "run": {
              "description": "Deliver to this run only; without it, to every waiter the caller owns",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "description": "Deliver a signal a workflow is waiting on",
        "reply": "task",
        "result": {
          "additionalProperties": false,
          "properties": {
            "delivered": {
              "minimum": 0,
              "type": "integer"
            },
            "signal": {
              "type": "string"
            }
          },
          "required": [
            "signal",
            "delivered"
          ],
          "type": "object"
        }
      }
    },
    "reserved": {
      "_instance.emit": {
        "args": {
          "additionalProperties": false,
          "properties": {
            "event": {
              "description": "The child's stream event: subject, correlation, data and id",
              "type": "object"
            },
            "handle": {
              "description": "The parent's handle for the child",
              "minLength": 1,
              "type": "string"
            },
            "stream": {
              "description": "The stream, by the name both sides declare",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "handle",
            "stream",
            "event"
          ],
          "type": "object"
        },
        "description": "reserved: one event of a child's `mirror_streams` stream, appended to the parent's stream of the same name; sent by the child over its channel, or by an operator",
        "reply": "task",
        "result": false
      },
      "_instance.result": {
        "args": {
          "additionalProperties": false,
          "properties": {
            "handle": {
              "description": "The parent's handle for the child",
              "minLength": 1,
              "type": "string"
            },
            "output": {
              "description": "The child's run output"
            },
            "status": {
              "description": "The child's run status"
            }
          },
          "required": [
            "handle"
          ],
          "type": "object"
        },
        "description": "reserved: a `mode: sync` child's first result, recorded on the parent's handle; sent by the child over its channel, or by an operator",
        "reply": "task",
        "result": false
      }
    }
  },
  "$id": "https://agentd.dev/a2a/ext/command/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The data of a command DataPart. $defs/envelopes/$defs/<op> is each op's envelope; $defs/ops/<op> and $defs/reserved/<op> give its reply kind (message or task), arguments and result — for a message op the document its reply carries, for a task op the data of the result artifact it completes with (false: none). Reserved ops are a child instance's, sent over the channel its parent handed it, or an operator's, and never listed in params.ops.",
  "properties": {
    "agentd": {
      "$ref": "#/$defs/envelope"
    }
  },
  "required": [
    "agentd"
  ],
  "title": "agentd command",
  "type": "object"
}
